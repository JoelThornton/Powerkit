flowchart LR
  S0{"How do you want<br/>to start?"}
  S0 -->|I know my analysis| SC["Shortcut list:<br/>straight to the form"]
  S0 -->|Help me choose| Q1{"Q1 What do you want<br/>your study to show?"}
  S0 -->|Plan my whole study| GP["Guided study planner:<br/>variables once, tick analyses,<br/>one card each + combined N"]

  subgraph GA["A. A difference between groups or conditions"]
    direction TB
    a2{"Outcome?"}
    a2 -->|Yes/no or categories,<br/>different people| aE5E6["E5 Two proportions<br/>E6 Chi-square"]
    a2 -->|Yes/no, same people<br/>or one group| aYN["E25 One proportion<br/>E26 McNemar"]
    a2 -->|Count or ordinal| aCO["E28 Count<br/>E29 Ordinal"]
    a2 -->|Score| a3{"Who gives the data?"}
    a3 -->|Stimuli, nested,<br/>3+ occasions| aML["E33 to E35<br/>Mixed, multilevel,<br/>longitudinal"]
    a3 -->|Different or<br/>same people| aF1{"How many factors?"}
    aF1 -->|One| aF2{"How many groups?"}
    aF2 -->|One or two| aT["E1 One-sample t<br/>E2 Independent t<br/>E3 Paired t"]
    aF2 -->|Three or more| aOW["E18 One-way ANOVA<br/>E19 Planned contrast"]
    aF1 -->|Two, crossed,<br/>2 x 2| aF4{"Between or within?<br/>Equal groups?"}
    aF4 -->|Both between| aE7["E7 2 x 2 between ANOVA"]
    aF4 -->|One within| aE8["E8 2 x 2 mixed ANOVA"]
    aF4 -->|Pre-post, ANCOVA| aE23["E23 ANCOVA"]
    aF4 -->|Both within, or<br/>unequal groups| aE20["E20, E22"]
    aF1 -->|Larger| aE21["E21 Larger factorial"]
  end

  subgraph GB["B. A relationship"]
    direction TB
    b1{"Outcome and<br/>other variable?"}
    b1 -->|Two scores| bE4["E4 Pearson correlation"]
    b1 -->|Several predictors| bE24["E24 Multiple regression"]
    b1 -->|Yes/no outcome| bE27["E27 Logistic regression"]
  end

  subgraph GC["C. Moderation"]
    direction TB
    c1{"What are X and W?"}
    c1 -->|Both scores| cE9["E9 Moderated regression"]
    c1 -->|One is yes/no| cE15["E15 Yes/no X or W"]
    c1 -->|Both two groups| cA["A 2 x 2 design (E7, E8)"]
    c1 -->|Three-way, 3+ groups| cL["E30, E31"]
  end

  subgraph GD["D. Mediation"]
    direction TB
    d1{"X, and the mediators?"}
    d1 -->|One mediator| dE10["E10 Simple mediation"]
    d1 -->|Side by side| dE11["E11 Parallel mediation"]
    d1 -->|In a chain| dE12["E12 Serial mediation"]
    d1 -->|X is yes/no| dE16["E16 Yes/no X"]
    d1 -->|X has 3+ groups| dE42["E42 Multi-category X"]
  end

  subgraph GE["E. Moderated mediation"]
    direction TB
    e1{"Which link does W change?"}
    e1 -->|X to M| eE13["E13 PROCESS model 7"]
    e1 -->|M to Y| eE14["E14 PROCESS model 14"]
    e1 -->|X or W yes/no| eE17["E17 Yes/no X or W"]
    e1 -->|Other models| eE38["E38, E40"]
  end

  Q1 -->|Absent, or<br/>model fits| QX["E36 Equivalence<br/>E37 CFA or SEM"]
  Q1 -->|Both| e1
  Q1 -->|Works through| d1
  Q1 -->|Depends on| c1
  Q1 -->|A relationship| b1
  Q1 -->|A difference| a2

  subgraph GF["F. After any end point: closing questions"]
    direction TB
    f1["Direction, test version"] --> f2{"What do you want<br/>to find out?"}
    f2 --> f3["Required N<br/>Power at a given N (planned effect)<br/>Smallest detectable effect"]
    f3 --> f4["Alpha, power, effect size<br/>and its source, attrition"]
  end


  subgraph KEY["Key"]
    direction TB
    k1{"Question"}
    k2["Runs in powerkit now"]
    k3["In the spec; engine<br/>refuses until phase 3b"]
    k4["Not in powerkit yet:<br/>points to another tool"]
  end

  class S0,Q1,a2,a3,aF1,aF2,aF4,b1,c1,d1,e1,f2,k1 q
  class aE5E6,aT,aE7,aE8,bE4,cE9,dE10,dE11,dE12,eE13,eE14,k2 avail
  class cE15,dE16,eE17,k3 spec
  class aYN,aCO,aML,aOW,aE23,aE20,aE21,bE24,bE27,cL,dE42,eE38,QX,k4 later
  class SC,GP,cA,f1,f3,f4 jump
  classDef q fill:#E8F0FB,stroke:#3B6FB6,color:#14284B,stroke-width:1.5px
  classDef avail fill:#DDF2E3,stroke:#2E7D4F,color:#123D24,stroke-width:1.5px
  classDef spec fill:#FFF0D1,stroke:#B97A00,color:#4A3200,stroke-width:1.5px
  classDef later fill:#F2F2F2,stroke:#9A9A9A,color:#4D4D4D,stroke-width:1px,stroke-dasharray:4 3
  classDef jump fill:#FFFFFF,stroke:#3B6FB6,color:#14284B,stroke-width:1.5px,stroke-dasharray:6 3
