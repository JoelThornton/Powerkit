{
  "spec_version": "0.1",
  "design": "reliability",
  "template": "cronbach_alpha",
  "variables": {
    "Y": {"type": "continuous", "label": "Study anxiety scale"}
  },
  "population": {
    "metric": "cronbach_alpha",
    "reliability": 0.8,
    "reliability_null": 0.7,
    "items": 5
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: an alpha of 0.8 expected, to show it is above 0.7."
  },
  "target_test": {"effect": "cronbach_alpha", "method": "bonett_wright", "alpha": 0.05},
  "goal": {"type": "sample_size", "power": 0.85},
  "options": {"seed": 45}
}
