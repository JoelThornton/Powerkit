  },
  "target_test": {
    "effect": "r_squared_change",
    "method": "f_test",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "nrep": 1000,
    "seed": 20261018
  }
}
