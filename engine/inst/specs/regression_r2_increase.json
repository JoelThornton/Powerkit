{
  "spec_version": "0.1",
  "design": "multiple_regression",
  "template": "r2_increase",
  "variables": {
    "Y": {
      "type": "continuous",
      "label": "Wellbeing score"
    }
  },
  "population": {
    "metric": "r_squared",
    "r2_full": 0.15,
    "r2_reduced": 0.1,
    "predictors_total": 5,
    "predictors_tested": 2
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
