{
  "spec_version": "0.1",
  "design": "basic_test",
  "template": "one_proportion",
  "variables": {
    "Y": {
      "type": "binary",
      "label": "Correct guess",
      "levels": [
        "No",
        "Yes"
      ]
    }
  },
  "population": {
    "metric": "proportion",
    "p": 0.65,
    "p0": 0.5
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: guessing right 65% of the time, against 50% by chance, is the smallest of interest."
  },
  "target_test": {
    "effect": "proportion_vs_constant",
    "method": "exact_binomial",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "nrep": 1000,
    "seed": 20261018
  }
}
