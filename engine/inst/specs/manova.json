{
  "spec_version": "0.1",
  "design": "basic_test",
  "template": "manova",
  "variables": {
    "A": {
      "type": "between_factor",
      "label": "Condition",
      "levels": ["Waiting list", "Online course", "Group course"]
    },
    "Y1": {"type": "continuous", "label": "Anxiety"},
    "Y2": {"type": "continuous", "label": "Depression"},
    "Y3": {"type": "continuous", "label": "Stress"}
  },
  "population": {
    "metric": "raw",
    "means": [[20, 18, 22], [18, 16.5, 20], [17, 16, 19]],
    "sds": [6, 5, 7],
    "r": 0.5
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: each course lowers the three scores by about a third to a half of an SD, the smallest change the team considers worthwhile."
  },
  "target_test": {
    "effect": "main_effect_A",
    "method": "pillai_trace",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "nrep": 1000,
    "seed": 20261030
  }
}
