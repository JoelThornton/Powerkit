{
  "spec_version": "0.1",
  "design": "logistic_regression",
  "template": "interaction",
  "variables": {
    "X": {
      "type": "continuous",
      "label": "Perceived stress"
    },
    "W": {
      "type": "continuous",
      "label": "Social support"
    },
    "Y": {
      "type": "binary",
      "label": "Sought counselling",
      "levels": [
        "No",
        "Yes"
      ]
    }
  },
  "population": {
    "metric": "odds_ratio",
    "base_prob": 0.25,
    "odds_ratio_x": 1.4,
    "odds_ratio_w": 1.1,
    "odds_ratio_xw": 1.25,
    "r_xw": -0.2
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: stress raises the odds of seeking counselling 1.4 times per SD at average support, and a quarter more for each SD of support is the smallest moderation of interest."
  },
  "target_test": {
    "effect": "interaction",
    "method": "wald_z",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "nrep": 1000,
    "seed": 20261104
  }
}
