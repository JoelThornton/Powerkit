{
  "spec_version": "0.1",
  "design": "factorial_anova",
  "template": "oneway_ancova",
  "variables": {
    "A": {
      "type": "between_factor",
      "label": "Intervention",
      "levels": [
        "Control",
        "Brief",
        "Full"
      ]
    },
    "Y": {
      "type": "continuous",
      "label": "Anxiety after"
    }
  },
  "population": {
    "metric": "raw",
    "means": [
      20,
      18,
      16
    ],
    "sd": 6,
    "r2_covariates": 0.36,
    "covariates": 1
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: a 4-point drop for the full intervention, adjusting for anxiety before, is the smallest of interest."
  },
  "target_test": {
    "effect": "main_effect_A",
    "method": "ancova_f",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "nrep": 1000,
    "seed": 20261018
  }
}
