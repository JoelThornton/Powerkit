{
  "spec_version": "0.1",
  "design": "mixed_model",
  "template": "two_level",
  "variables": {
    "X": {"type": "continuous", "label": "Homework time"},
    "W": {"type": "continuous", "label": "Teacher experience"},
    "Y": {"type": "continuous", "label": "Maths score"}
  },
  "population": {
    "metric": "raw",
    "b_X": 0.3,
    "b_W": 0.2,
    "b_XW": 0.1,
    "sd_group": 0.4,
    "sd_group_slope": 0.15,
    "sd_residual": 1,
    "cluster_size": 20
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: pupils in classes; a cross-level interaction of 0.1 SD per SD of teacher experience is the smallest of interest."
  },
  "target_test": {
    "effect": "cross_level_interaction",
    "method": "satterthwaite_t",
    "alpha": 0.05
  },
  "goal": {
    "type": "power",
    "n": 800
  },
  "options": {
    "nrep": 200,
    "seed": 41
  }
}
