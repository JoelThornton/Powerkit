{
  "spec_version": "0.1",
  "design": "equivalence_test",
  "template": "tost_independent",
  "variables": {
    "X": {
      "type": "binary",
      "label": "Condition",
      "levels": [
        "Control",
        "Training"
      ]
    },
    "Y": {
      "type": "continuous",
      "label": "Anxiety score"
    }
  },
  "population": {
    "metric": "standardised",
    "d": 0,
    "bound": 0.5
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: the smallest difference that would matter, so anything smaller counts as no meaningful difference."
  },
  "target_test": {
    "effect": "mean_difference",
    "method": "tost",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "attrition": 0.1,
    "seed": 20261027
  }
}
