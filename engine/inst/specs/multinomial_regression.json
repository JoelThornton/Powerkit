{
  "spec_version": "0.1",
  "design": "logistic_regression",
  "template": "multinomial",
  "variables": {
    "X": {
      "type": "continuous",
      "label": "Health anxiety"
    },
    "Y": {
      "type": "categorical",
      "label": "Where help was first sought",
      "levels": [
        "General practitioner",
        "Online search",
        "Friends or family"
      ]
    }
  },
  "population": {
    "metric": "proportion",
    "probabilities": [
      0.5,
      0.3,
      0.2
    ],
    "probabilities_second": [
      0.42,
      0.38,
      0.2
    ]
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: at average health anxiety, half first see a general practitioner, 30% search online and 20% ask friends or family; one SD higher, a shift of 8 points from the practitioner to searching online is the smallest effect of interest."
  },
  "target_test": {
    "effect": "odds_ratios",
    "method": "likelihood_ratio",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "nrep": 1000,
    "seed": 20261104
  }
}
