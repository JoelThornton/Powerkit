{
  "spec_version": "0.1",
  "design": "precision",
  "template": "odds_ratio",
  "variables": {
    "X": {
      "type": "binary",
      "label": "Group",
      "levels": [
        "Control",
        "Treatment"
      ]
    },
    "Y": {
      "type": "binary",
      "label": "Recovered"
    }
  },
  "population": {
    "metric": "probability",
    "p1": 0.3,
    "p2": 0.45
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: recovery is expected in 30% and 45%; the odds ratio's interval should be no wider than 1."
  },
  "target_test": {
    "effect": "confidence_interval",
    "method": "indip_smooth",
    "alpha": 0.05
  },
  "goal": {
    "type": "precision",
    "width": 1
  }
}
