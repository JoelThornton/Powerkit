{
  "spec_version": "0.1",
  "design": "basic_test",
  "template": "mcnemar",
  "variables": {
    "X": {
      "type": "within_factor",
      "label": "Session",
      "levels": [
        "Before training",
        "After training"
      ]
    },
    "Y": {
      "type": "binary",
      "label": "Passed",
      "levels": [
        "No",
        "Yes"
      ]
    }
  },
  "population": {
    "metric": "proportion",
    "p_first_only": 0.1,
    "p_second_only": 0.25
  },
  "effect_justification": {
    "type": "smallest_effect_of_interest",
    "source": "Example only: 15 more people in every 100 switching to a pass than to a fail is the smallest of interest."
  },
  "target_test": {
    "effect": "paired_proportion_difference",
    "method": "mcnemar_exact",
    "alpha": 0.05
  },
  "goal": {
    "type": "sample_size",
    "power": 0.8
  },
  "options": {
    "nrep": 1000,
    "seed": 20261018
  }
}
