            },
            "means": {
              "$ref": "#/definitions/matrix_2x2_numbers"
            },
            "sd": {
              "$ref": "#/definitions/cell_sd"
            },
            "r": {
              "description": "Correlation between the two repeated measurements (levels of B) within a participant.",
              "$ref": "#/definitions/correlation"
            }
          }
        }
      }
    },
    "design_regression_interaction": {
      "if": {
        "required": [
          "design"
