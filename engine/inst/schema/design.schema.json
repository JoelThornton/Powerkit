      "then": {
        "properties": {
          "template": {
            "enum": [
              "two_way"
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "template"
              ],
              "properties": {
                "template": {
                  "const": "two_way"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/template_two_way"
            }
          }
        ]
      }
    },
    "template_two_way": {
      "description": "Y regressed on X, W and their product XW. Parametrised by correlations, as in InteractionPoweR.",
      "properties": {
        "variables": {
          "required": [
            "X",
            "W",
            "Y"
          ],
          "additionalProperties": false,
          "properties": {
            "X": {
              "$ref": "#/definitions/variable_continuous_or_binary"
            },
            "W": {
              "$ref": "#/definitions/variable_continuous_or_binary"
            },
            "Y": {
              "$ref": "#/definitions/variable_continuous"
            }
          }
        },
        "population": {
          "required": [
            "metric",
            "r_X_Y",
            "r_W_Y",
            "r_XW_Y",
            "r_X_W"
