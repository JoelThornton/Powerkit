                "$ref": "#/definitions/variable_continuous_or_binary"
              },
              "W": {
                "$ref": "#/definitions/variable_continuous_or_binary"
              },
              "M": {
                "$ref": "#/definitions/variable_continuous"
              },
              "Y": {
                "$ref": "#/definitions/variable_continuous"
              }
            }
          },
          "population": {
            "required": [
              "metric",
              "paths"
            ],
            "additionalProperties": false,
            "properties": {
              "metric": {
                "const": "standardised"
              },
              "paths": {
                "$ref": "#/definitions/paths"
              },
              "correlations": {
                "description": "Correlation between X and W, keyed 'X<->W'. Omitted means 0 (e.g. X randomised).",
                "$ref": "#/definitions/correlation_map"
              }
            }
          },
          "target_test": {
            "allOf": [
              {
                "$ref": "#/definitions/two_sided_only"
              },
              {
                "properties": {
                  "path": false,
                  "effect": {
                    "const": "index_of_moderated_mediation"
