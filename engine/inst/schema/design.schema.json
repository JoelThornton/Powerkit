          {
            "if": {
              "required": [
                "template"
              ],
              "properties": {
                "template": {
                  "const": "process_6"
                }
              }
            },
            "then": {
              "$ref": "#/definitions/template_process_6"
            }
          }
        ]
      }
    },
    "template_process_4": {
      "description": "PROCESS model 4: simple mediation (one mediator, named M) or parallel mediation (mediators M1, M2, ...).",
      "properties": {
        "variables": {
          "required": [
            "X",
            "Y"
          ],
          "additionalProperties": false,
          "properties": {
            "X": {
              "$ref": "#/definitions/variable_continuous_or_binary"
            },
            "Y": {
              "$ref": "#/definitions/variable_continuous"
            }
          },
          "patternProperties": {
            "^M[1-9]?$": {
              "description": "mediators named M (one mediator) or M1, M2, ... (several)",
              "$ref": "#/definitions/variable_continuous"
            }
          }
        },
        "population": {
