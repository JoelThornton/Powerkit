                "effect": {
                  "const": "interaction"
                },
                "method": {
                  "const": "ols_t"
                }
              }
            }
          ]
        }
      }
    },
    "design_mediation": {
      "if": {
        "required": [
          "design"
        ],
        "properties": {
          "design": {
            "const": "mediation"
          }
        }
      },
      "then": {
        "properties": {
          "template": {
            "enum": [
              "process_4",
              "process_6"
            ]
          },
          "target_test": {
            "required": [
              "path"
            ],
            "allOf": [
              {
                "$ref": "#/definitions/two_sided_only"
              },
              {
                "properties": {
