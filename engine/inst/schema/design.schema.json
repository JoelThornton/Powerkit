            "r_X_Y": {
              "$ref": "#/definitions/correlation"
            },
            "r_W_Y": {
              "$ref": "#/definitions/correlation"
            },
            "r_XW_Y": {
              "description": "Correlation between the product term XW and Y: the interaction effect.",
