              "description": "mediators named M1, M2, ... (up to M4), in causal order",
              "$ref": "#/definitions/variable_continuous"
            }
          }
        },
        "population": {
          "required": [
            "metric",
            "paths"
          ],
          "additionalProperties": false,
          "properties": {
            "metric": {
              "const": "standardised"
            },
            "paths": {
              "$ref": "#/definitions/paths"
            }
          }
        }
      }
    },
    "design_moderated_mediation": {
      "if": {
        "required": [
